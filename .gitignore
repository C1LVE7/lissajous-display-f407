# ==========================================================
# Keil MDK 编译产物
# 用 "目录/*" 而不是 "目录/"，否则负向规则（!）不生效
# ==========================================================
MDK-ARM/FFT/*
!MDK-ARM/FFT/FFT.sct

# 中间文件与最终产物
*.o
*.d
*.crf
*.axf
*.hex
*.bin
*.map
*.lnp
*.lst
*.dep
*.htm
*.iex
*.build_log.htm

# Keil 用户界面状态（每人机器不同，不入库）
*.uvguix.*
*.uvoptx.bak
*.uvprojx.bak
JLinkLog.txt
JLinkSettings.ini

# 构建日志
*.log

# ==========================================================
# IDE / 编辑器
# ==========================================================
.vscode/
.idea/
*.swp

# ==========================================================
# 系统临时文件
# ==========================================================
Thumbs.db
desktop.ini
.DS_Store
